{
    "name": "gardenia-desktop",
    "private": true,
    "version": "0.1.0",
    "description": "Gardenia Desktop Application",
    "author": {
        "name": "Gardenia Team",
        "email": "contact@gardenia.app"
    },
    "homepage": "https://github.com/gardenia-desktop",
    "license": "Apache-2.0",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && tsc -p electron/tsconfig.json",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder"
    },
    "build": {
        "appId": "com.gardenia.desktop",
        "productName": "Gardenia",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../engine",
                "to": "engine",
                "filter": [
                    "**/*",
                    "!.venv/**/*",
                    "!__pycache__/**/*"
                ]
            },
            {
                "from": "electron/r_bridge.R",
                "to": "r_bridge.R"
            },
            {
                "from": "electron/python_bridge.py",
                "to": "python_bridge.py"
            },
            {
                "from": "electron/bash_bridge.py",
                "to": "bash_bridge.py"
            }
        ],
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "tar.gz"
            ],
            "icon": "public/icon.png",
            "category": "Science"
        }
    },
    "dependencies": {
        "@types/dagre": "^0.7.53",
        "@types/ws": "^8.18.1",
        "@xyflow/react": "^12.0.0-next.14",
        "clsx": "^2.1.0",
        "dagre": "^0.8.5",
        "lucide-react": "^0.363.0",
        "path-browserify": "^1.0.1",
        "prismjs": "^1.30.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-simple-code-editor": "^0.14.1",
        "tailwind-merge": "^2.2.2",
        "ws": "^8.19.0",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@types/path-browserify": "^1.0.3",
        "@types/prismjs": "^1.26.5",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^29.4.6",
        "electron-builder": "^24.13.3",
        "eslint": "^8.57.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.2.2",
        "vite": "^5.2.0",
        "wait-on": "^7.2.0"
    }
}